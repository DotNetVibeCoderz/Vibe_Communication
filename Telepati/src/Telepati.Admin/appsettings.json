{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": { "Url": "https://localhost:7210" }
    }
  },
  "TelepatiClient": {
    "ServerUrl": "https://localhost:7180",
    "Transport": "Rest"
  },
  "Telepati": {
    "Branding": {
      "AppName": "Telepati",
      "Tagline": "Ngobrol seru, tanpa jeda.",
      "Company": "Gravicode Studios",
      "Leader": "Kang Fadhil"
    },
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=../Telepati.Server/telepati.db",
      "AutoMigrate": true,
      "SeedSampleData": true
    },
    "Cache": {
      "Provider": "Memory"
    },
    "Storage": {
      "Provider": "FileSystem",
      "RootPath": "../Telepati.Server/bin/Debug/net10.0/storage",
      "PublicBaseUrl": "/files"
    },
    "Security": {
      "JwtSecret": "telepati-development-secret-key-change-me!",
      "EnableTwoFactor": true
    },
    "Bot": {
      "Handle": "bacot",
      "DisplayName": "Kang Bacot"
    }
  }
}
