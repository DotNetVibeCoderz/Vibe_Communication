{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7180",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://localhost:7181",
        "Protocols": "Http2"
      }
    }
  },
  "Telepati": {
    "Branding": {
      "AppName": "Telepati",
      "Tagline": "Ngobrol seru, tanpa jeda.",
      "Company": "Gravicode Studios",
      "Leader": "Kang Fadhil",
      "SupportEmail": "support@telepati.app",
      "LogoUrl": "/img/telepati-logo.svg"
    },
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=telepati.db",
      "AutoMigrate": true,
      "SeedSampleData": true,
      "EnableSensitiveDataLogging": false,
      "CommandTimeoutSeconds": 30,
      "Sharding": {
        "Enabled": false,
        "Strategy": "ChatId",
        "Shards": []
      }
    },
    "Cache": {
      "Provider": "Memory",
      "ConnectionString": "localhost:6379",
      "InstanceName": "telepati:",
      "DefaultTtlSeconds": 300,
      "PresenceTtlSeconds": 60
    },
    "Storage": {
      "Provider": "FileSystem",
      "RootPath": "storage",
      "PublicBaseUrl": "/files",
      "ContainerName": "telepati",
      "ConnectionString": "",
      "Endpoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "Region": "us-east-1",
      "UseSsl": true,
      "SignedUrlTtlMinutes": 60
    },
    "Security": {
      "JwtIssuer": "Telepati",
      "JwtAudience": "TelepatiClients",
      "JwtSecret": "telepati-development-secret-key-change-me!",
      "AccessTokenMinutes": 60,
      "RefreshTokenDays": 30,
      "EnableEndToEndEncryption": false,
      "EnableTwoFactor": true,
      "RequireTwoFactorForAdmins": false,
      "MaxActiveSessions": 10,
      "MaxFailedLoginAttempts": 5,
      "LockoutMinutes": 15,
      "AllowedCorsOrigins": []
    },
    "Features": {
      "EnableVoiceCall": true,
      "EnableVideoCall": true,
      "EnableStatus": true,
      "EnableChannels": true,
      "EnableBroadcast": true,
      "EnableBots": true,
      "EnableNearbySearch": true,
      "EnableStickers": true,
      "EnableGrpcTransport": true,
      "EnableRestTransport": true,
      "EnableSignalRTransport": true,
      "IceServers": [ "stun:stun.l.google.com:19302", "stun:stun1.l.google.com:19302" ],
      "MinNearbyRadiusKm": 5,
      "MaxNearbyRadiusKm": 100
    },
    "Bot": {
      "Enabled": true,
      "Handle": "bacot",
      "DisplayName": "Kang Bacot",
      "AvatarUrl": "/img/bacot.svg",
      "Provider": "Ollama",
      "_Provider_options": "OpenAI | AzureOpenAI | DeepSeek | Anthropic | Gemini | Ollama",
      "Model": "llama3.2",
      "ApiKey": "",
      "Endpoint": "http://localhost:11434",
      "Temperature": 0.8,
      "TopP": 0.95,
      "MaxTokens": 2048,
      "AutoCompactThreshold": 0.75,
      "ContextWindowTokens": 32000,
      "MaxTurnsKeptVerbatim": 20,
      "WorkspacePath": "workspace",
      "EnableCodeExecution": true,
      "AllowPackageInstall": false,
      "ExecutionTimeoutSeconds": 120,
      "AllowedExecutors": [ "powershell", "python", "dotnet", "cmd", "node" ],
      "TavilyApiKey": "",
      "EnableWebSearch": true,
      "MaxFunctionCallsPerTurn": 8
    },
    "Theme": {
      "DefaultMode": "system",
      "DefaultThemeName": "Telepati Classic",
      "EnableSeasonalThemes": true,
      "AllowUserThemeOverride": true,
      "EnableMicroInteractions": true
    },
    "Limits": {
      "MaxUploadBytes": 104857600,
      "MaxGroupMembers": 500,
      "MaxBroadcastRecipients": 1000,
      "MaxPinnedMessages": 5,
      "MessagePageSize": 50,
      "MaxMessageLength": 8000,
      "StatusRetentionHours": 24
    }
  }
}
