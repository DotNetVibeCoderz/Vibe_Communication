{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": { "Url": "https://localhost:7200" }
    }
  },
  "TelepatiClient": {
    "ServerUrl": "https://localhost:7180",
    "Transport": "SignalR",
    "AutoReconnect": true,
    "ReconnectDelaySeconds": 3,
    "PollIntervalSeconds": 5,
    "ShareLocation": false,
    "AllowContactImport": false,
    "EnableNotificationSound": true,
    "ThemeMode": "system"
  },
  "Telepati": {
    "Branding": {
      "AppName": "Telepati",
      "Tagline": "Ngobrol seru, tanpa jeda.",
      "Company": "Gravicode Studios",
      "Leader": "Kang Fadhil"
    },
    "Bot": {
      "Handle": "bacot",
      "DisplayName": "Kang Bacot"
    },
    "Features": {
      "MinNearbyRadiusKm": 5,
      "MaxNearbyRadiusKm": 100
    }
  }
}
