<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Authors>Gravicode Studios</Authors>
    <Company>Gravicode Studios</Company>
    <Product>Rumble.Net</Product>
    <Copyright>© 2026 Gravicode Studios — led by Kang Fadhil</Copyright>
    <RepositoryUrl>https://github.com/gravicode/Rumble.Net</RepositoryUrl>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <NativeRoot>$(MSBuildThisFileDirectory)native\</NativeRoot>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
