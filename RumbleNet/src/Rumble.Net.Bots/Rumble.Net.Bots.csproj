<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Rumble.Net.Bots</PackageId>
    <Title>Rumble.Net Bots</Title>
    <Description>Bot framework for Rumble.Net: command routing, lifecycle hooks, hosted-service integration and AI chat responders built on Microsoft.Extensions.AI. Made by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>mumble;bot;ai;chatbot;voice;rumble</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rumble.Net\Rumble.Net.csproj" />
    <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
