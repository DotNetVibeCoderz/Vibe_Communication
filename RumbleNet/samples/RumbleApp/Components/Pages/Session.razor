@page "/session"
@using Rumble.Net.Events
@using Rumble.Net.Models
@inject VoiceSession Voice
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(Voice.Server?.Name ?? "Session") · RumbleApp</PageTitle>

@if (Voice.Client is null)
{
    <div class="page page-narrow">
        <h1>No server connected</h1>
        <p style="color:var(--ink-soft)">Pick a server to see its channels and start talking.</p>
        @if (Voice.Problem is { } problem)
        {
            <p class="notice problem">@problem</p>
        }
        <a class="btn btn-primary" href="/">Choose a server</a>
    </div>
}
else
{
    var client = Voice.Client;
    <div class="session @(_showChat ? "show-chat" : null)">
        <header class="session-bar">
            <div class="title">
                <span class="label">@StateLabel(client.State)</span>
                <h2>@Voice.Server?.Name</h2>
            </div>
            <div class="segmented tabs" role="tablist">
                <button aria-pressed="@(!_showChat ? "true" : "false")" @onclick="() => _showChat = false">Channels</button>
                <button aria-pressed="@(_showChat ? "true" : "false")" @onclick="() => _showChat = true">Chat</button>
            </div>
            <div class="stats mono">
                <span title="Round-trip time to the server">@client.Server.TcpPingMs.ToString("0") ms</span>
                <span title="Voice transport">@(client.Server.UdpActive ? "UDP" : "TCP")</span>
                <span>@client.Server.Users.Count users</span>
            </div>
            <button class="btn btn-quiet" @onclick="Leave" title="Disconnect from @Voice.Server?.Name">
                <Icon Name="exit" /> <span>Leave</span>
            </button>
        </header>

        <section class="tree-pane pane" aria-label="Channels">
            @if (Voice.AudioNotice is { } audioNotice)
            {
                <p class="notice" style="margin:0 0 10px">@audioNotice</p>
            }
            @if (client.Server.Root is { } root)
            {
                <ChannelNode Channel="root" SelectedSession="_selected" OnSelectUser="Select" ToolsFor="Tools" />
            }
            else
            {
                <p class="chat-empty">Loading channels…</p>
            }
        </section>

        <ChatPanel />
        <TransmitStrip />
    </div>
}

@code {
    private bool _showChat;
    private uint? _selected;

    protected override void OnInitialized()
    {
        Voice.Changed += OnChanged;
        Voice.Tick += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Select(User user) => _selected = _selected == user.Session ? null : user.Session;

    private void SetVolume(User user, ChangeEventArgs e)
    {
        if (float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var volume))
        {
            Voice.Client?.Audio.SetUserVolume(user, volume);
        }
    }

    private async Task Leave()
    {
        await Voice.DisconnectAsync();
        Nav.NavigateTo("/");
    }

    private static string StateLabel(ConnectionState state) => state switch
    {
        ConnectionState.Connected => "Connected",
        ConnectionState.Reconnecting => "Reconnecting…",
        ConnectionState.Connecting or ConnectionState.Synchronizing => "Connecting…",
        _ => "Offline",
    };

    private RenderFragment<User> Tools => user => __builder =>
    {
        var client = Voice.Client!;
        var volume = client.Audio.GetUserVolume(user);
        var locallyMuted = client.Audio.IsUserMuted(user);
        <div class="user-tools">
            @if (!user.IsSelf)
            {
                <span class="label">Volume <span class="mono">@((volume * 100).ToString("0"))%</span></span>
                <input type="range" min="0" max="2" step="0.05" value="@volume.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       aria-label="Volume for @user.Name"
                       @oninput="e => SetVolume(user, e)" />
                <div class="buttons">
                    <button class="btn" @onclick="() => client.Audio.SetUserMuted(user, !locallyMuted)">@(locallyMuted ? "Unmute for me" : "Mute for me")</button>
                    <button class="btn" @onclick="() => { Voice.PrivateTarget = user; _showChat = true; }">Message</button>
                </div>
            }
            else
            {
                <span class="label">This is you</span>
                <span style="color:var(--ink-soft)">@(user.Channel?.Path ?? "")</span>
                <div class="buttons">
                    <button class="btn" @onclick="Voice.ToggleMute">@(user.SelfMute ? "Unmute" : "Mute")</button>
                </div>
            }
        </div>
    };

    public void Dispose()
    {
        Voice.Changed -= OnChanged;
        Voice.Tick -= OnChanged;
    }
}
