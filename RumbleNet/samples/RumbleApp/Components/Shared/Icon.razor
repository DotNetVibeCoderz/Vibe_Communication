@* Inline stroke icons (24px grid, currentColor). *@
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="@Class">
    @switch (Name)
    {
        case "servers":
            <rect x="3" y="4" width="18" height="6" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" /><path d="M7 7h.01M7 17h.01" />
            break;
        case "session":
            <path d="M4 12h2l2-5 3 10 3-7 2 4h4" />
            break;
        case "settings":
            <path d="M4 7h10M18 7h2M4 17h4M12 17h8" /><circle cx="16" cy="7" r="2" /><circle cx="10" cy="17" r="2" />
            break;
        case "about":
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" />
            break;
        case "mic-off":
            <path d="M9 9v2a3 3 0 0 0 5.1 2.1M15 10V6a3 3 0 0 0-5.7-1.3" /><path d="M5 11a7 7 0 0 0 11.5 5.3M19 11a7 7 0 0 1-.6 2.8M12 18v3M3 3l18 18" />
            break;
        case "mic":
            <rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" />
            break;
        case "deaf":
            <path d="M3 14v-2a9 9 0 0 1 14.5-7.1M21 12v2M3 3l18 18" /><path d="M3 14h3v6H4a1 1 0 0 1-1-1zM18 17v3h2a1 1 0 0 0 1-1v-5h-3" />
            break;
        case "headphones":
            <path d="M3 14v-2a9 9 0 0 1 18 0v2" /><path d="M3 14h3v6H4a1 1 0 0 1-1-1zM21 14h-3v6h2a1 1 0 0 0 1-1z" />
            break;
        case "chevron":
            <path d="M6 9l6 6 6-6" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "edit":
            <path d="M4 20h4L19 9l-4-4L4 16z" />
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />
            break;
        case "send":
            <path d="M4 12l16-8-6 16-2-6z" />
            break;
        case "exit":
            <path d="M10 5H5v14h5M14 8l4 4-4 4M18 12H9" />
            break;
        case "chat":
            <path d="M4 5h16v11H9l-5 4z" />
            break;
        case "tree":
            <path d="M5 4v16M5 8h6M5 16h6" /><rect x="11" y="5" width="8" height="6" rx="1" /><rect x="11" y="13" width="8" height="6" rx="1" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="9" rx="1.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string? Class { get; set; }
}
