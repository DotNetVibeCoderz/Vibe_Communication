<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RumbleGallery.ViewModels"
        xmlns:infra="using:RumbleGallery.Infrastructure"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="RumbleGallery.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RumbleGallery — Rumble.Net samples"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Background="{DynamicResource PanelBrush}">

    <Grid ColumnDefinitions="300,*">

        <!-- Sample index -->
        <Border Grid.Column="0" Background="{DynamicResource SunkBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,12,12">
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="4,0,4,14">
                    <TextBlock Classes="label" Text="RUMBLE.NET" />
                    <TextBlock Classes="title" FontSize="22" Text="Sample gallery" />
                    <TextBlock Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap" FontSize="13"
                               Text="Every sample runs against a Mumble server built into the gallery." />
                </StackPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding Search}" PlaceholderText="Search samples" Margin="0,0,0,10" CornerRadius="6" />
                <TextBlock DockPanel.Dock="Bottom" Classes="label" Margin="4,10,0,0" Text="{Binding SampleCountText}" />
                <ListBox Classes="samples" ItemsSource="{Binding VisibleSamples}" SelectedItem="{Binding SelectedSample}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="infra:GallerySample">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="label" Text="{Binding CategoryUpper}" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Selected sample -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,22,24,16">
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{Binding SelectedSample.CategoryUpper, FallbackValue=''}" />
                    <TextBlock Classes="title" Text="{Binding SelectedSample.Title, FallbackValue='Choose a sample'}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedSample.Description, FallbackValue=''}" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Classes="quiet" Content="Copy code" Command="{Binding CopyCodeCommand}" />
                    <Button Classes="quiet" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />
                    <Button Classes="primary" Content="{Binding RunButtonText}" Command="{Binding RunCommand}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="3*,6,2*" Margin="24,0,24,0">
                <Border Grid.Column="0" Background="{StaticResource CodeBackgroundBrush}" CornerRadius="8" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="#34414A" BorderThickness="0,0,0,1">
                            <TextBlock Classes="label" Foreground="#97A4A7" Text="{Binding SelectedSample.FileName, FallbackValue='CODE'}" />
                        </Border>
                        <ae:TextEditor x:Name="CodeEditor" IsReadOnly="True" ShowLineNumbers="True" FontSize="13"
                                       FontFamily="{StaticResource MonoFont}" Background="Transparent" Foreground="#E6EAE3"
                                       Padding="8,6" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

                <Border Grid.Column="2" Background="{StaticResource ConsoleBrush}" CornerRadius="8" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="16,6,8,6" BorderBrush="#34414A" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AmberBrush}" IsVisible="{Binding IsRunning}" />
                                    <TextBlock Classes="label" Foreground="#97A4A7" Text="{Binding OutputHeader}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearOutputCommand}" Background="Transparent" Foreground="#97A4A7" Padding="10,4" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="OutputList" ItemsSource="{Binding Output}" Background="Transparent" Padding="6">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="8,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="infra:OutputLine">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#6C7A7E" Margin="0,1,10,0" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap" Foreground="{Binding Foreground}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,14,0,0" Padding="28,8" Background="{DynamicResource SunkBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ServerStatus}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" VerticalAlignment="Center">
                        <Run Text="Made by " /><Run Text="Gravicode Studios" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><Run Text=", led by " /><Run Text="Kang Fadhil" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
