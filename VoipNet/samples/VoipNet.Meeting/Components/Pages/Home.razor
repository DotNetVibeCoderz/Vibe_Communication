@page "/"
@implements IAsyncDisposable
@inject MeetingRoom Room
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Meeting room · Voip.NET</PageTitle>

<section class="room">
    @* The stage: one picture at a time, because the engine forwards video rather than mixing it. *@
    <article class="module raised stage">
        <div class="stage-frame @(InRoom ? "" : "idle")">
            <video @ref="_stage" autoplay playsinline class="@(_stats is { VideoIn: > 0 } ? "" : "waiting")"></video>
            @if (!InRoom)
            {
                <p class="stage-hint">Join and the room puts whoever is speaking on this screen.</p>
            }
            else if (_stats is null or { VideoIn: 0 })
            {
                <p class="stage-hint">Waiting for the first frame from the room…</p>
            }

            <video @ref="_self" autoplay playsinline muted class="self @(InRoom ? "" : "hidden")"></video>
        </div>
        <figcaption class="stage-caption">
            <div>
                <span class="eyebrow">@(Room.Pinned ? "Pinned" : "Speaking")</span>
                <div class="display on-screen">@(Room.OnScreen?.Name ?? (InRoom ? "Nobody yet" : "The room is quiet"))</div>
            </div>
            <span class="mono soft small">@(_stats is { VideoIn: > 0 } s ? $"{s.Codec} {s.Size} · {s.VideoIn} frames in / {s.VideoOut} out" : "—")</span>
        </figcaption>
    </article>

    <article class="module join">
        <h1 class="display">Meet in the browser,<br />mixed by Voip.NET</h1>
        <p class="soft lede">Every tab calls the same SIP address over a WebSocket. The engine mixes the audio minus your own voice and forwards the camera of whoever is talking.</p>

        @if (!InRoom)
        {
            <div class="name-field">
                <label class="eyebrow" for="name">Your name</label>
                <input id="name" value="@_name" @oninput="@(e => _name = e.Value?.ToString() ?? "")"
                       @onkeydown="@(async e => { if (e.Key == "Enter") { await JoinAsync(); } })"
                       placeholder="Sari" autocomplete="off" />
            </div>
            <div class="actions">
                <button class="btn go" @onclick="JoinAsync" disabled="@(_module is null || string.IsNullOrWhiteSpace(_name))">Join the room</button>
                <span class="status @(_phase == "failed" ? "bad" : "")" role="status">@PhaseText</span>
            </div>
        }
        else
        {
            <audio @ref="_audio" autoplay></audio>
            <div class="actions">
                <button class="btn danger" @onclick="LeaveAsync">Leave</button>
                <button class="btn" @onclick="ToggleMuteAsync">@(_muted ? "Unmute" : "Mute")</button>
                <span class="status" role="status">@PhaseText</span>
            </div>
            <div class="meters">
                <div class="meter">
                    <span class="eyebrow">Your microphone</span>
                    <div class="ladder" aria-hidden="true">
                        @for (var i = 0; i < 24; i++)
                        {
                            var lit = (_stats?.Level ?? 0) * 24 > i;
                            <span class="@(lit ? i > 19 ? "on hot" : "on" : "")"></span>
                        }
                    </div>
                </div>
            </div>
            <dl class="facts">
                <div><dt class="eyebrow">SRTP</dt><dd class="mono">@Show(_stats?.Srtp)</dd></div>
                <div><dt class="eyebrow">ICE pair</dt><dd class="mono">@Show(_stats?.Pair)</dd></div>
                <div><dt class="eyebrow">Keyframes asked / sent</dt><dd class="mono">@(_stats is null ? "—" : $"{_stats.Pli} / {_stats.KeyframesOut}")</dd></div>
                <div><dt class="eyebrow">Encodings sent</dt><dd class="mono">@(_encodings.Length == 0 ? "—" : _encodings)</dd></div>
                <div><dt class="eyebrow">Sending allowance</dt><dd class="mono">@(_stats is null or { Allowance: 0 } ? "—" : $"{_stats.Allowance} kbit/s")</dd></div>
            </dl>
        }
    </article>
</section>

<article class="module roster">
    <div class="section-head">
        <h2 class="display">In the room</h2>
        <span class="pill">@Room.Participants.Count @(Room.Participants.Count == 1 ? "participant" : "participants")</span>
    </div>
    @if (Room.Participants.Count == 0)
    {
        <p class="empty">Nobody has joined yet. Open this page in another tab or on another machine to meet yourself.</p>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Media</th>
                    <th class="num">Sent</th>
                    <th class="num">Received</th>
                    <th class="num">Frames</th>
                    <th class="num">Can take</th>
                    <th class="num">MOS</th>
                    <th>On screen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Room.Participants)
                {
                    var stats = p.Stats;
                    var onScreen = Room.OnScreen?.Call.Id == p.Call.Id;
                    <tr class="@(onScreen ? "on-air" : "")">
                        <td>
                            <strong>@p.Name</strong>
                            <div class="soft small">joined @p.Joined.ToString("HH:mm:ss")</div>
                        </td>
                        <td class="mono small">
                            @(p.Security is { } sec ? $"DTLS-SRTP {sec}" : "securing…")@(p.SendingVideo ? $" · {p.Call.VideoCodec}" : "")
                            @{
                                var layers = p.SendingVideo ? p.Call.VideoLayers : [];
                            }
                            @if (layers.Count > 1)
                            {
                                <span> · </span>
                                @foreach (var layer in layers)
                                {
                                    <span class="@(layer.Selected ? "layer on" : "layer")">@layer.Name @(layer.BitsPerSecond / 1000)k</span>
                                }
                            }
                        </td>
                        <td class="num">@(stats?.PacketsSent.ToString() ?? "—")</td>
                        <td class="num">@(stats?.PacketsReceived.ToString() ?? "—")</td>
                        <td class="num">@(p.VideoFrames == 0 ? "—" : p.VideoFrames.ToString())</td>
                        <td class="num">@(stats is null or { RemoteEstimateBps: 0 } ? "—" : $"{stats.RemoteEstimateBps / 1000} kbit/s")</td>
                        <td class="num">@(stats is null || stats.Mos <= 0 ? "—" : stats.Mos.ToString("0.00"))</td>
                        <td>
                            @if (onScreen)
                            {
                                <span class="pill live">@(Room.Pinned ? "pinned" : "speaking")</span>
                            }
                            <button class="btn small" @onclick="@(() => Room.Pin(p))">Pin</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="roster-actions">
            <button class="btn small" @onclick="Room.FollowSpeaker" disabled="@(!Room.Pinned)">Follow the speaker</button>
        </div>
    }
</article>

<article class="module log">
    <div class="section-head">
        <h2 class="display">Room log</h2>
        <span class="soft small mono">ws://@(Host):@MeetingRoom.WebSocketPort</span>
    </div>
    @if (Room.Events.Count == 0)
    {
        <p class="empty">Nothing yet.</p>
    }
    else
    {
        <ol class="events">
            @foreach (var e in Room.Events.Take(12))
            {
                <li>
                    <span class="mono soft">@e.Time.ToString("HH:mm:ss.fff")</span>
                    <span class="tag @e.Kind">@e.Kind</span>
                    <span>@e.Text</span>
                </li>
            }
        </ol>
    }
</article>

@code {
    /// <summary>What the page script reads from <c>RTCPeerConnection.getStats()</c>.</summary>
    public sealed record BrowserStats(double Level, long VideoIn, long VideoOut, string Size, string Codec, string Srtp, string Pair, long Pli, long KeyframesOut, long Allowance);

    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _self_ref;
    private ElementReference _stage;
    private ElementReference _self;
    private ElementReference _audio;
    private string _name = "";
    private string _phase = "idle";
    private string _detail = "";
    private bool _muted;
    private string _encodings = "";
    private BrowserStats? _stats;
    private Timer? _refresh;

    private bool InRoom => _phase is "devices" or "connecting" or "inviting" or "trying" or "ringing" or "joined" or "pc-new" or "pc-connecting" or "pc-connected";

    private string Host => new Uri(Navigation.BaseUri).Host;

    private string PhaseText => _phase switch
    {
        "idle" => "Your browser will ask for the camera and microphone.",
        "devices" => "Waiting for camera and microphone…",
        "connecting" => "Opening the SIP WebSocket…",
        "inviting" or "trying" => "Calling the room…",
        "ringing" => "Ringing…",
        "joined" or "pc-new" or "pc-connecting" => "Answered. Securing the media path…",
        "pc-connected" => _muted ? "In the room, muted." : "In the room.",
        "left" => $"You left: {_detail}.",
        "failed" => $"Could not join: {_detail}",
        _ => _detail,
    };

    protected override void OnInitialized()
    {
        Room.Changed += OnRoomChanged;
        _refresh = new Timer(_ => InvokeAsync(StateHasChanged), null, 500, 500);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./meeting.js");
            _self_ref = DotNetObjectReference.Create(this);
            StateHasChanged();
        }
    }

    private async Task JoinAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || _module is null)
        {
            return;
        }

        _stats = null;
        _muted = false;
        _phase = "devices";
        await _module.InvokeVoidAsync("join", _self_ref, $"ws://{Host}:{MeetingRoom.WebSocketPort}", _name.Trim(), _self, _stage, _audio);
    }

    private async Task LeaveAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("leave");
        }
    }

    private async Task ToggleMuteAsync()
    {
        if (_module is not null)
        {
            _muted = await _module.InvokeAsync<bool>("mute", !_muted);
        }
    }

    [JSInvokable]
    public Task OnPhase(string phase, string detail)
    {
        if (phase == "encodings")
        {
            // How many encodings of the camera survived the answer: simulcast only happens when the
            // room keeps them.
            _encodings = detail;
            return InvokeAsync(StateHasChanged);
        }

        if (!(phase.StartsWith("pc-") && _phase is "left" or "failed"))
        {
            _phase = phase == "pc-failed" ? "failed" : phase;
            _detail = phase == "pc-failed" ? "ICE or DTLS could not connect" : detail;
        }

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnStats(BrowserStats stats)
    {
        _stats = stats;
        return Task.CompletedTask;
    }

    private static string Show(string? value) => string.IsNullOrEmpty(value) ? "—" : value;

    private void OnRoomChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Room.Changed -= OnRoomChanged;
        if (_refresh is not null)
        {
            await _refresh.DisposeAsync();
        }

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("leave");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The tab is gone; its call ended with it.
        }

        _self_ref?.Dispose();
    }
}
