{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning"
    }
  },

  // SIP account the agent answers on. Leave Domain empty to accept direct calls on SipPort.
  "Sip": {
    "BindAddress": "0.0.0.0",
    "SipPort": 5070,
    "Domain": "",
    "Username": "ai-agent",
    "Password": "",
    "DisplayName": "Voip.NET AI Agent",
    "RegisterOnStart": false
  },

  "Agent": {
    // "pipeline": speech-to-text → chat model → text-to-speech (any providers)
    // "realtime": OpenAI realtime speech-to-speech model
    "Mode": "pipeline",
    "Greeting": "Halo, dengan asisten AI Gravicode Net. Ada yang bisa saya bantu?",
    "SystemPrompt": "Kamu asisten layanan pelanggan ISP Gravicode Net. Jawab singkat, sopan, dalam bahasa Indonesia. Tawarkan transfer ke agen manusia bila diminta.",
    "Language": "id-ID",
    "HandoffTarget": "sip:operator@pbx.local"
  },

  // Keys are best kept in user secrets or environment variables, e.g. AI__Chat__ApiKey.
  "AI": {
    "Chat": {
      "Provider": "azure",          // openai | azure | deepseek | anthropic | gemini | compatible
      "Endpoint": "",
      "ApiKey": "",
      "Model": "gpt-5-mini"
    },
    "SpeechToText": {
      "Provider": "deepgram",       // deepgram | openai | google | elevenlabs | elbruno
      "ApiKey": ""
    },
    "TextToSpeech": {
      "Provider": "elevenlabs",     // elevenlabs | openai | google | polly | elbruno
      "ApiKey": "",
      "Voice": ""
    },
    "Realtime": {
      "ApiKey": "",
      "Model": "gpt-realtime",
      "Voice": "alloy"
    }
  }
}
