<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VoipNet.Video</PackageId>
    <Description>Voip.NET Video — H.264 encoding and decoding through the platform's own codec (Media Foundation on Windows), camera and screen capture, a grid and picture-in-picture compositor, BGRA/NV12 conversion, and a test pattern for machines with no camera.</Description>
    <RootNamespace>VoipNet.Video</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
