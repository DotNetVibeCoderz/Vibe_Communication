<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VoipNet.Enterprise</PackageId>
    <Description>Voip.NET Enterprise — IVR flows with AI, call queues and agent routing, recording, analytics and CRM tools for contact centres.</Description>
    <RootNamespace>VoipNet.Enterprise</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoipNet.Core\VoipNet.Core.csproj" />
    <ProjectReference Include="..\VoipNet.Audio\VoipNet.Audio.csproj" />
    <ProjectReference Include="..\VoipNet.AI\VoipNet.AI.csproj" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
