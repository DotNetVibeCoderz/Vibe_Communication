<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VoipNet.Core</PackageId>
    <Description>Voip.NET Core — SIP/RTP/WebRTC engine with a .NET API: calls, media, DTMF, SRTP, conferencing. Rust-powered, cross-platform.</Description>
    <RootNamespace>VoipNet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!--
    Native engine, produced by build/build-native.ps1 (or cargo build, release profile, in native/).
    Every runtime identifier found under native/target is packed; the local build output is copied
    next to the managed assembly so samples and tests run straight from the repository.
  -->
  <PropertyGroup>
    <NativeOutputDir>$(MSBuildThisFileDirectory)..\..\native\target\release\</NativeOutputDir>
    <NativeArtifactsDir>$(MSBuildThisFileDirectory)..\..\artifacts\native\</NativeArtifactsDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeOutputDir)voipnet_core.dll" Condition="Exists('$(NativeOutputDir)voipnet_core.dll')">
      <Link>voipnet_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/win-x64/native/</PackagePath>
    </None>
    <None Include="$(NativeOutputDir)libvoipnet_core.so" Condition="Exists('$(NativeOutputDir)libvoipnet_core.so')">
      <Link>libvoipnet_core.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-x64/native/</PackagePath>
    </None>
    <None Include="$(NativeOutputDir)libvoipnet_core.dylib" Condition="Exists('$(NativeOutputDir)libvoipnet_core.dylib')">
      <Link>libvoipnet_core.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/osx-arm64/native/</PackagePath>
    </None>
    <!-- CI stages one native library per runtime under src/VoipNet.Core/runtimes/<rid>/native/. -->
    <None Include="runtimes\**\*">
      <Pack>true</Pack>
      <!-- NuGet appends %(RecursiveDir) (<rid>/native/) itself. -->
      <PackagePath>runtimes/</PackagePath>
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Additional runtimes cross-built locally into artifacts/native/<rid>/. -->
    <None Include="$(NativeArtifactsDir)**\*" Condition="Exists('$(NativeArtifactsDir)')">
      <Pack>true</Pack>
      <PackagePath>runtimes/</PackagePath>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
