<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VoipNet.AI</PackageId>
    <Description>Voip.NET AI — turn calls into conversations: streaming speech to text, large language models (OpenAI, Anthropic, Gemini, OpenAI-compatible), text to speech, barge-in and tool calling.</Description>
    <RootNamespace>VoipNet.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoipNet.Core\VoipNet.Core.csproj" />
    <ProjectReference Include="..\VoipNet.Audio\VoipNet.Audio.csproj" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
